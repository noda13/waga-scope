{
  "name": "waga-scope-backend",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "@waga-scope/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "express": "^4.21.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "node-cron": "^3.0.3",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/node": "^22.7.5",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "prisma": "^5.21.1",
    "supertest": "7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
